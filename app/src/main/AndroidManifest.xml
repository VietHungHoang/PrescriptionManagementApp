<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mad.prescriptionmanagementapp">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PrescriptionManagementApp"
        android:supportsRtl="true">
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- DrugDetailActivity -->
        <activity
            android:name=".ui.activity.DrugDetailActivity"
            android:exported="false" />
        <!-- MedicineSearchActivity -->
        <activity
            android:name=".ui.activity.MedicineSearchActivity"
            android:exported="false" >

        </activity>
        <!-- ProfileActivity -->
        <activity
            android:name=".ui.activity.ProfileActivity"
            android:exported="false">

        </activity>
        <!-- ProfileSettingActivity -->
        <activity
            android:name=".ui.activity.ProfileSettingActivity"
            android:exported="false" />
        <!-- TermsOfServiceActivity -->
        <activity
            android:name=".ui.activity.TermsOfServiceActivity"
            android:exported="false" />
<!--        NotificationSettingsActivity-->
        <activity
            android:name=".ui.activity.NotificationSettingsActivity"
            android:exported="false" />
    </application>

</manifest>