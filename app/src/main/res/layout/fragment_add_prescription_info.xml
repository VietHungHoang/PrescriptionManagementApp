                    <View
                        android:id="@+id/line"
                        android:layout_width="wrap_content"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_weight="1"
                        android:background="@color/lineSelectColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="48dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/edt_padding">
                        <!-- Thông tin khám bệnh -->
                        <Switch
                            android:id="@+id/switch_medical_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Thông tin khám bệnh"
                            android:textColor="@color/black"
                            android:textSize="@dimen/lbl_textsize"
                            android:textStyle="bold"
                            android:thumb="@drawable/toggle_thumb"
                            android:track="@drawable/toggle_track"
                            tools:ignore="UseSwitchCompatOrMaterialXml" />


                        <!-- CardView chứa thông tin khám bệnh -->

                        <FrameLayout
                            android:id="@+id/card_medical_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/lineLeft"
                                    android:layout_width="wrap_content"
                                    android:layout_height="1dp"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:background="@color/lineSelectColor"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/txtTitle" />

                                <!-- Bệnh viện / Phòng khám -->

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="Bệnh viện / Phòng khám"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/lbl_textsize"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/edt_hospital"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/edt_height"
                                    android:layout_marginBottom="24dp"
                                    android:background="@drawable/edittext_bg_normal"
                                    android:hint="Nhập tên bệnh viện / phòng khám"
                                    android:paddingHorizontal="@dimen/edt_padding"
                                    android:textColor="@color/black"
                                    android:textColorHint="#84888C"
                                    android:textSize="@dimen/edt_textsize" />

                                <!-- Tên bác sĩ -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:text="Bác sĩ"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/lbl_textsize"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/edt_doctor"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/edt_height"
                                    android:background="@drawable/edittext_bg_normal"
                                    android:hint="Nhập tên bác sĩ"
                                    android:paddingHorizontal="@dimen/edt_padding"
                                    android:textColor="@color/black"
                                    android:textColorHint="#84888C"
                                    android:textSize="@dimen/edt_textsize" />

                                <!-- Ngày khám -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="Ngày khám"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/lbl_textsize"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/edt_consultation_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/edt_height"
                                    android:background="@drawable/edittext_bg_normal"
                                    android:clickable="true"
                                    android:drawableEnd="@drawable/ic_calendar"
                                    android:focusable="false"
                                    android:hint="Chọn ngày khám"
                                    android:inputType="none"
                                    android:paddingHorizontal="@dimen/edt_padding"
                                    android:textColor="@color/black"
                                    android:textColorHint="#84888C"
                                    android:textSize="@dimen/edt_textsize" />

                                <!-- Ngày tái khám -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="Ngày tái khám"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/lbl_textsize"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/edt_follow_up_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/edt_height"
                                    android:background="@drawable/edittext_bg_normal"
                                    android:clickable="true"
                                    android:drawableEnd="@drawable/ic_calendar"
                                    android:focusable="false"
                                    android:hint="Chọn ngày tái khám"
                                    android:inputType="none"
                                    android:paddingHorizontal="@dimen/edt_padding"
                                    android:textColor="@color/black"
                                    android:textColorHint="#84888C"
                                    android:textSize="@dimen/edt_textsize" />

                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/shadow_top" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/btn_end_background"
                android:padding="@dimen/edt_padding">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_save"
                    style="@android:style/Widget.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_bg"
                    android:text="Lưu đơn thuốc"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
