<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.mad.prescriptionmanagementapp.ui.viewmodel.AddPrescriptionViewModel" />
    </data>

    <FrameLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.fragment.addprescription.AddPrescriptionInfoFragment">

        <LinearLayout
            android:id="@+id/ui_add_prescription_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Nút lưu -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:layout_editor_absoluteY="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/edt_padding">
                        <!-- Nhập tên đơn thuốc -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="* "
                                android:textColor="@color/red"
                                android:textSize="@dimen/lbl_textsize"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tên đơn thuốc"
                                android:textColor="@color/black"
                                android:textSize="@dimen/lbl_textsize"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/edt_prescription_name"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edt_height"
                            android:background="@drawable/edittext_bg_normal"
                            android:hint="Nhập tên đơn thuốc"
                            android:paddingHorizontal="@dimen/edt_padding"
                            android:textColor="@color/black"
                            android:textColorHint="#84888C"
                            android:textSize="@dimen/edt_textsize" />

                        <TextView
                            android:id="@+id/txtErrorName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawableStart="@drawable/ic_attention"
                            android:drawablePadding="6dp"
                            android:text="@{viewModel.errorMessage}"
                            android:textColor="@color/red"
                            android:textSize="@dimen/error_textsize"
                            android:textStyle="normal"
                            android:visibility="gone"/>

                        <!-- Danh sách thuốc -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="* "
                                android:textColor="@color/red"
                                android:textSize="@dimen/lbl_textsize"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Danh sách thuốc"
                                android:textColor="@color/black"
                                android:textSize="@dimen/lbl_textsize"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_drug"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_add_btn"
                            android:text="+ Thêm thuốc"
                            android:textAllCaps="false"
                            android:textColor="@color/blue"
                            android:textSize="16sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <!-- Nhắc nhở uống thuốc -->
