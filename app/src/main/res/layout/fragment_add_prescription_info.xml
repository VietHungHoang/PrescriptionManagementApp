    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.addprescription.AddPrescriptionInfoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingTop="16dp"
        >

        <!-- Nút lưu -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteY="26dp"
            android:layout_weight="1"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/edt_padding"
                    >
                    <!-- Nhập tên đơn thuốc -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="* "
                            android:textColor="@color/red"
                            android:textStyle="bold"
                            android:textSize="@dimen/lbl_textsize"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tên đơn thuốc"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="@dimen/lbl_textsize"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edt_prescription_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/edt_height"
                        android:background="@drawable/edittext_bg_normal"
                        android:hint="Nhập tên đơn thuốc"
                        android:paddingHorizontal="@dimen/edt_padding"
                        android:textColor="@color/black"
                        android:textColorHint="#84888C"
                        android:textSize="@dimen/edt_textsize"
                        android:layout_marginBottom="24dp"
                        />

                    <!-- Danh sách thuốc -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="* "
                            android:textColor="@color/red"
                            android:textStyle="bold"
                            android:textSize="@dimen/lbl_textsize"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Danh sách thuốc"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="@dimen/lbl_textsize"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_drug"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_add_btn"
                        android:text="+ Thêm thuốc"
                        android:textAllCaps="false"
                        android:textColor="@color/blue"
                        android:textSize="16sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

