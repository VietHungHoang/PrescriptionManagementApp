<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.fragment.AddPrescriptionInfoFragment">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Nhập tên đơn thuốc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* "
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên đơn thuốc"
                    android:textStyle="bold"
                    />
            </LinearLayout>
                <EditText
                    android:id="@+id/edt_prescription_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edt_height"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/edittext_bg_normal"
                    android:textSize="@dimen/edt_textsize"
                    android:textColor="@color/black"
                    android:hint="Nhập tên đơn thuốc"
                    android:textColorHint="#84888C"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_them_thuoc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="+ Thêm thuốc"
                android:layout_marginTop="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/bg_add_btn"
                android:textColor="@color/blue"
                android:textAllCaps="false" />







            <!-- Nhắc nhở uống thuốc -->
            <Switch
                android:id="@+id/switch_nhac_nho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nhắc nhở uống thuốc"
                android:textSize="16sp"
                android:paddingTop="10dp"
                android:checked="true"/>

            <!-- Layout ẩn/hiện theo switch nhắc nhở -->
            <LinearLayout
                android:id="@+id/layout_nhac_nho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Ngày bắt đầu uống -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ngày bắt đầu uống"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_ngay_bat_dau"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:hint="Chọn ngày bắt đầu"
                        android:textColor="@android:color/black"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Số ngày uống -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Số ngày uống"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_so_ngay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@android:color/black"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Thông tin khám bệnh -->
            <Switch
                android:id="@+id/switch_kham_benh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thêm thông tin khám bệnh"
                android:textSize="16sp"
                android:paddingTop="10dp"/>

            <!-- CardView chứa thông tin khám bệnh -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_kham_benh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                android:padding="12dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Bệnh viện / Phòng khám -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bệnh viện / Phòng khám"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_benh_vien"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:textColor="@android:color/black"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tên bác sĩ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tên bác sĩ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_ten_bac_si"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:textColor="@android:color/black"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ngày khám -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ngày khám"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_ngay_kham"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:enabled="false"
                            android:textColor="@android:color/black"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ngày tái khám -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ngày tái khám"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edt_ngay_tai_kham"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true"
                            android:enabled="false"
                            android:textColor="@android:color/black"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút lưu -->
            <Button
                android:id="@+id/btn_luu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Lưu đơn thuốc"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/blue"
                android:textColor="@android:color/white"
                android:textAllCaps="false"/>
        </LinearLayout>
</FrameLayout>