<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.mad.prescriptionmanagementapp.ui.viewmodel.AddPrescriptionViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.fragment.addprescription.FrequencySelectionFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/white">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#FFFFFF"
                android:paddingTop="16dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <!-- Nhóm chọn tần suất -->
                    <RadioGroup
                        android:id="@+id/radioGroupFrequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/edt_padding"
                        >

                        <RadioButton
                            android:id="@+id/radioDaily"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Hằng ngày"
                            android:textColor="#000000"
                            android:textSize="@dimen/lbl_textsize"
                            app:buttonTint="@color/radio_button_color"/>

                        <!-- Divider -->
                        <View
                            android:id="@+id/divider2"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"/>

                        <RadioButton
                            android:id="@+id/radioEveryNDays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Cách số ngày"
                            android:textColor="#000000"
                            android:textSize="@dimen/lbl_textsize"
                            app:buttonTint="@color/radio_button_color"/>

                        <!-- Divider -->
                        <View
                            android:id="@+id/divider3"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"/>

                        <RadioButton
                            android:id="@+id/radioSpecificDays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Chọn ngày cụ thể"
                            android:textColor="#000000"
                            android:textSize="@dimen/lbl_textsize"
                            app:buttonTint="@color/radio_button_color"/>
                    </RadioGroup>

                    <!-- Counter section -->

                    <View
                        android:id="@+id/lineLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:background="@color/lineSelectColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTitle" />

<!--                    Chon cach ngay-->
                    <androidx.constraintlayout.widget.ConstraintLayout

                        android:id="@+id/numberOfDaysLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="22dp"
                        android:layout_marginTop="8dp"
                        >



                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cách mỗi"
                            android:textColor="#000000"
                            android:textSize="@dimen/lbl_textsize"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <!-- Nút giảm -->
                        <ImageButton
                            android:id="@+id/btn_decrease"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Back"
                            android:src="@drawable/ic_subtracting"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tv_count"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Nút tăng -->
                        <ImageButton
                            android:id="@+id/btnIncrease"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Tăng"
                            android:src="@drawable/ic_addtracting"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tv_count"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngày"
                            android:textColor="#000000"
                            android:textSize="@dimen/lbl_textsize"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <!-- Layout chọn ngày cụ thể -->
                    <LinearLayout
                        android:id="@+id/daysOfWeekLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:paddingHorizontal="16dp"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chọn ngày uống thuốc"
                            android:textColor="#000000"
                            android:textSize="@dimen/lbl_textsize"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginLeft="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Vui lòng chọn ít nhất một ngày uống thuốc"
                            android:textColor="#4D4D4D"
                            android:textSize="@dimen/lbl_textsize"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginLeft="8dp"/>

                        <CheckBox
                            android:id="@+id/cbMonday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Thứ hai"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <CheckBox
                            android:id="@+id/cbTuesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Thứ ba"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <CheckBox
                            android:id="@+id/cbWednesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Thứ tư"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <CheckBox
                            android:id="@+id/cbThursday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Thứ năm"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <CheckBox
                            android:id="@+id/cbFriday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Thứ sáu"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <CheckBox
                            android:id="@+id/cbSaturday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Thứ bảy"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <CheckBox
                            android:id="@+id/cbSunday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/blue"
                            android:text="Chủ nhật"
                            android:textColor="#000000"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Save Button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/shadow_top" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/btn_end_background"
                android:padding="@dimen/edt_padding">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_continue"
                    style="@android:style/Widget.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_bg"
                    android:text="Tiếp tục"
                    android:textColor="@color/white"
                    android:textSize="@dimen/lbl_textsize"
                    android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</layout>