<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Light red/pink background color -->
    <solid android:color="#FDE5E5" />

    <!-- Red border with 1dp width -->
    <stroke
        android:width="1dp"
        android:color="#FA7D7D" />

    <!-- Rounded corners with 8dp radius -->
    <corners android:radius="8dp" />

    <!-- Optional padding inside the shape -->
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp" />
</shape>