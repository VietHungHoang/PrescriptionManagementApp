<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Trạng thái lỗi (ưu tiên cao nhất) -->
    <item app:state_error="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#FF0000"/> <!-- Viền đỏ khi lỗi -->
        </shape>
    </item>

    <!-- Focus -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#2D87F3"/> <!-- Viền xanh -->
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#D3D0D0"/> <!-- Viền xám -->
        </shape>
    </item>
</selector>