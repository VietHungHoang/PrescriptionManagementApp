<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi item được chọn (selected) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- Màu trắng -->
            <corners android:radius="0dp" />
        </shape>
    </item>
    <!-- Khi item không được chọn (default) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- Màu trong suốt -->
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>